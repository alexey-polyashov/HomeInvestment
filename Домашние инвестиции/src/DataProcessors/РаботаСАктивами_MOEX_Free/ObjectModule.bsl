Процедура ЗаполнитьВидыАктивов()
	
	ЭлементETF = Справочники.ВидыАктивов.ETF.ПолучитьОбъект();
	ЭлементETF.БлокMOEX = "stock";
	ЭлементETF.РынокMOEX = "etf";
	ЭлементETF.Записать();

	ЭлементАкция = Справочники.ВидыАктивов.Акция.ПолучитьОбъект();
	ЭлементАкция.БлокMOEX = "stock";
	ЭлементАкция.РынокMOEX = "shares";
	ЭлементАкция.Записать();
	
	ЭлементФьючерс = Справочники.ВидыАктивов.Фьючерс.ПолучитьОбъект();
	ЭлементФьючерс.БлокMOEX = "futures";
	ЭлементФьючерс.РынокMOEX = "futures";
	ЭлементФьючерс.Записать();
	
	ЭлементОблигация = Справочники.ВидыАктивов.Облигация.ПолучитьОбъект();
	ЭлементОблигация.БлокMOEX = "bond";
	ЭлементОблигация.РынокMOEX = "bonds";
	ЭлементОблигация.Записать();
	
	ЭлементВалюта = Справочники.ВидыАктивов.Валюта.ПолучитьОбъект();
	ЭлементВалюта.БлокMOEX = "currency";
	ЭлементВалюта.РынокMOEX = "currencies";
	ЭлементВалюта.Записать();
	
КонецПроцедуры

// Функция НайтиАктивыВMOEX остается без изменений
Функция НайтиАктивыВMOEX(СтрокаПоиска)
	
	Результат = Новый Массив;
	
	РынкиДляПоиска = Новый Массив;
	РынкиДляПоиска.Добавить("shares");
	РынкиДляПоиска.Добавить("bonds");
	
	Для Каждого Рынок Из РынкиДляПоиска Цикл
		
		АдресЗапроса = СтрШаблон(
			"https://iss.moex.com/iss/securities.json?q=%1&is_trading=1&group_by=group&limit=100&engine=stock&market=%2",
			СтрокаПоиска,
			Рынок
		);
		
		Соединение = Новый HTTPСоединение(АдресРесурса, , , , , , Новый ЗащищенноеСоединениеOpenSSL());
		HTTPRequest = Новый HTTPЗапрос(АдресЗапроса);
		
		Попытка
			HTTPОтвет = Соединение.Получить(HTTPRequest);
			ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
			
			ДанныеJSON = Неопределено;
			ПрочитатьJSON(ДанныеJSON, ТелоОтвета);
			
			Если ДанныеJSON = Неопределено Или Не ДанныеJSON.Свойство("securities") Тогда
				Продолжить;
			КонецЕсли;
			
			Блоки = ДанныеJSON["securities"];
			
			Для Каждого Ключ Из Блоки.Ключи() Цикл
				Если ТипЗнч(Блоки[Ключ]) = Тип("Структура") И Блоки[Ключ].Свойство("data") Тогда
					Колонки = Блоки[Ключ]["columns"];
					СтрокиДанных = Блоки[Ключ]["data"];
					
					ИндексТикера 		= Колонки.Найти("secid");
					ИндексНаименования  = Колонки.Найти("name");
					ИндексКраткогоНаименования = Колонки.Найти("shortname");
					ИндексISIN 			= Колонки.Найти("isin");
					ИндексНоминала 		= Колонки.Найти("facevalue");
					
					Для Каждого СтрокаДанных Из СтрокиДанных Цикл
						ДанныеАктива = Новый Структура;
						ДанныеАктива.Вставить("Тикер", СтрокаДанных[ИндексТикера]);
						ДанныеАктива.Вставить("ПолноеНаименование", СтрокаДанных[ИндексНаименования]);
						ДанныеАктива.Вставить("КраткоеНаименование", СтрокаДанных[ИндексКраткогоНаименования]);
						ДанныеАктива.Вставить("ISIN", ?(ЗначениеЗаполнено(СтрокаДанных[ИндексISIN]), СтрокаДанных[ИндексISIN], ""));
						
						Номинал = 0;
						Если ИндексНоминала <> Неопределено И ЗначениеЗаполнено(СтрокаДанных[ИндексНоминала]) Тогда
							Номинал = Число(СтрокаДанных[ИндексНоминала]);
						КонецЕсли;
						ДанныеАктива.Вставить("Номинал", Номинал);
						
						Результат.Добавить(ДанныеАктива);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			
		Исключение
			ЗаписьЖурналаРегистрации("ПоискАктивовMOEX", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при поиске в API: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

