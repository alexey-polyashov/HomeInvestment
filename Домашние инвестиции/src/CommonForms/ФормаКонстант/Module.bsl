
#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьСписокМодулейРаботыСВалютами();
	ОбновитьСписокМодулейРаботыСАктивами();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура МодульДляРаботыСВалютамиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("МодульДляРаботыСВалютамиНачалоВыбораЗавершение", ЭтотОбъект), СписокОбработокДляРаботыСВалютами, Элемент);	
КонецПроцедуры


&НаКлиенте
Процедура МодульДляРаботыСАктивамиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("МодульДляРаботыСАктивамиНачалоВыбораЗавершение", ЭтотОбъект), СписокОбработокДляРаботыСАктивами, Элемент);

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

// Код процедур и функций

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура МодульДляРаботыСВалютамиНачалоВыбораЗавершение(РезультатВыбора, ДопПараметры) Экспорт

	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборКонстант.МодульДляРаботыСВалютами = РезультатВыбора.Значение;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура МодульДляРаботыСАктивамиНачалоВыбораЗавершение(РезультатВыбора, ДопПараметры) Экспорт

	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаборКонстант.МодульДляРаботыСАктивами = РезультатВыбора.Значение;
	Модифицированность = Истина;
	
КонецПроцедуры


Функция ОбновитьСписокМодулейРаботыСВалютами()

	СписокОбработокДляРаботыСВалютами = Новый СписокЗначений;
	Элементы.МодульДляРаботыСВалютами.СписокВыбора.Очистить();
	
	СписокОбработокСОписанием = ПолучитьОписанияМодулейВсехОбработок();
	
	Для каждого ОбработкаСОписанием Из СписокОбработокСОписанием Цикл

		ОписаниеОбработки = ОбработкаСОписанием.Значение;

		Если ОписаниеОбработки.ВидОбработки = "ДополнительныеМодуль" Тогда
			Если ОписаниеОбработки.ТипМодуля = "ЗагрузкаКурсовВалют" тогда
				СписокОбработокДляРаботыСВалютами.Добавить(ОбработкаСОписанием.Ключ, СтрШаблон("%1 (%2)", ОписаниеОбработки.Заголовок, ОписаниеОбработки.Версия));
				Элементы.МодульДляРаботыСВалютами.СписокВыбора.Добавить(ОбработкаСОписанием.Ключ, СтрШаблон("%1 (%2)", ОписаниеОбработки.Заголовок, ОписаниеОбработки.Версия));
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокОбработокДляРаботыСВалютами;
		
КонецФункции


Функция ОбновитьСписокМодулейРаботыСАктивами()

	СписокОбработокДляРаботыСАктивами= Новый СписокЗначений;
	Элементы.МодульДляРаботыСАктвиами.СписокВыбора.Очистить();
	
	СписокОбработокСОписанием = ПолучитьОписанияМодулейВсехОбработок();
	
	Для каждого ОбработкаСОписанием Из СписокОбработокСОписанием Цикл

		ОписаниеОбработки = ОбработкаСОписанием.Значение;

		Если ОписаниеОбработки.ВидОбработки = "ДополнительныеМодуль" Тогда
			Если ОписаниеОбработки.ТипМодуля = "РаботаСАктивами" тогда
				СписокОбработокДляРаботыСВалютами.Добавить(ОбработкаСОписанием.Ключ, СтрШаблон("%1 (%2)", ОписаниеОбработки.Заголовок, ОписаниеОбработки.Версия));
				Элементы.МодульДляРаботыСВалютами.СписокВыбора.Добавить(ОбработкаСОписанием.Ключ, СтрШаблон("%1 (%2)", ОписаниеОбработки.Заголовок, ОписаниеОбработки.Версия));
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокОбработокДляРаботыСВалютами;
		
КонецФункции

// Функция получает описания модулей всех обработок в конфигурации.
// Вызывает экспортную функцию ОписаниеМодуля() из модуля объекта каждой обработки.
//
// Возвращаемое значение:
//   Соответствие - Ключ - Полное имя обработки в метаданных (Строка),
//                  Значение - Результат, возвращенный функцией ОписаниеМодуля().
Функция ПолучитьОписанияМодулейВсехОбработок()

	Результат = Новый Соответствие;

	// Перебираем все обработки, зарегистрированные в метаданных конфигурации
	Для Каждого МетаданныеОбработки Из Метаданные.Обработки Цикл
		
		// Создаем временный экземпляр объекта обработки для вызова его методов
		ОбъектОбработки = Обработки[МетаданныеОбработки.Имя].Создать();
		
		Попытка
			// Вызываем экспортную функцию из модуля объекта
			// Если функции не существует, будет сгенерировано исключение
			ОписаниеМодуля = ОбъектОбработки.ОписаниеМодуля();
			
			// Сохраняем результат в соответствие, где ключ - это полное имя обработки
			Результат.Вставить(МетаданныеОбработки.Имя, ОписаниеМодуля);
			
		Исключение
			// Если при вызове функции произошла ошибка (например, функции нет или она вызвала исключение),
			// игнорируем ее, чтобы не прерывать обработку остальных обработок.
			// Ошибки вида "Метод объекта не обнаружен" также будут обработаны здесь.
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции



#КонецОбласти
