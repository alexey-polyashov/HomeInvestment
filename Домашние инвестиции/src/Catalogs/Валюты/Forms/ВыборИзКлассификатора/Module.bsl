
#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Код процедур и функций
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокВалют = ПолучитьСписокВалютИзКлассификатораНаСервере();
	Для каждого СписокВалютЭлемент Из СписокВалют Цикл
		НоваяСтрока = СписокВыборкиВалюты.Добавить();
		НоваяСтрока.КодВалюты = СписокВалютЭлемент.Значение.ЦифровойКод;
		НоваяСтрока.СимвольныйКод = СписокВалютЭлемент.Значение.СимвольныйКод;
		НоваяСтрока.ПолноеНаименование = СписокВалютЭлемент.Представление;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Код процедур и функций

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Добавить(Команда)
	
	ТекущаяСтрока = Элементы.СписокВыборкиВалюты.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите валюту из списка'"));
		Возврат;
	Иначе
		Закрыть(Новый Структура("КодВалюты, СимвольныйКод, ПолноеНаименование", ТекущаяСтрока.КодВалюты, ТекущаяСтрока.СимвольныйКод, ТекущаяСтрока.ПолноеНаименование));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Синхронная функция для получения данных с сайта
&НаСервереБезКонтекста
Функция ПолучитьСписокВалютИзКлассификатораНаСервере()
	
	СписокДляВыбора = Новый СписокЗначений;
	
	// 1. Получаем XML-текст от ЦБ РФ
	Попытка
		HTTPСоединение = Новый HTTPСоединение("www.cbr.ru", , , , , , Новый ЗащищенноеСоединениеOpenSSL());
		HTTPЗапрос = Новый HTTPЗапрос("/scripts/XML_valFull.asp");
		HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
		
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Сообщить("Ошибка при запросе к сайту ЦБ РФ: " + HTTPОтвет.КодСостояния, СтатусСообщения.Внимание);
			Возврат Неопределено;
		КонецЕсли;
		
		ТекстXML = HTTPОтвет.ПолучитьТелоКакСтроку();
		
	Исключение
		Сообщить("Ошибка при подключении к сайту ЦБ РФ: " + ОписаниеОшибки(), СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецПопытки;
	
	// 2. Надежный и простой парсинг XML с помощью ЧтениеXML
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстXML);
	ЧтениеXML.ИгнорироватьПробелы = Истина; // Игнорировать узлы с пробелами
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		// Ищем начало элемента <Item>
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Item" Тогда
			
			СимвольныйКод = "";
			ПолноеНаименование = "";
			ЦифровойКод = "";
			
			// Получаем значение атрибута "Name" напрямую
			ПолноеНаименование = СокрЛП(ЧтениеXML.ЗначениеАтрибута("Name"));
			
			// Читаем все дочерние узлы элемента <Item>
			Пока ЧтениеXML.Прочитать() Цикл
				
				// Как только встретили конец </Item>, выходим из внутреннего цикла
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "Item" Тогда
					Прервать;
				КонецЕсли;
				
				// Если это начало тега, который нам нужен...
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
					ИмяТега = ЧтениеXML.Имя;
					
					// ...то читаем следующий узел, который будет текстом
					Если ЧтениеXML.Прочитать() Тогда
						ЗначениеТега = СокрЛП(ЧтениеXML.Значение);
						
						Если ИмяТега = "Name" Тогда
							ПолноеНаименование = ЗначениеТега;
						ИначеЕсли ИмяТега = "ISO_Char_Code" Тогда
							СимвольныйКод = ЗначениеТега;
						ИначеЕсли ИмяТега = "ISO_Num_Code" Тогда
							ЦифровойКод = ЗначениеТега;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			// Если все данные собраны, добавляем в список
			Если Не ПустаяСтрока(СимвольныйКод) И Не ПустаяСтрока(ЦифровойКод) И Не ПустаяСтрока(ПолноеНаименование) Тогда
				СтруктураДанных = Новый Структура("СимвольныйКод, ПолноеНаименование, ЦифровойКод", СимвольныйКод, ПолноеНаименование, ЦифровойКод);
				СписокДляВыбора.Добавить(СтруктураДанных, ПолноеНаименование);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеXML.Закрыть();
	
	Возврат СписокДляВыбора;
	
КонецФункции

#КонецОбласти
